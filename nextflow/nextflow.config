conda {
    enabled = true
    useMamba = true
}

params {
    network_uuid = ''
    network_name = 'test'
    OUTDIR = "${projectDir}/results"
}

/*
* Output Settings
*/
outputDir = "results"
workflow {
    output.mode = 'copy'
}

/*
* Profiles
*/
profiles {
    standard {
        process.executor = 'local'
    }
    local_dev {
        process.executor = 'local'
        params.network_uuid = '9881c2f3-f137-11ee-9621-005056ae23aa'
        params.network_name = 'bioplex'
        params.common_traits_file = "${projectDir}/data/common_test_traits.txt" 
        params.rare_traits_file = "${projectDir}/data/rare_test_traits.txt"
        params.geneset_datadir = "/Users/snwright/Git/CARVA/outputs"
        params.gene_score_transform = 'neglog10'
        params.gene_score_normalization = 'sum'
        params.seed_gene_col = "Gene Symbol"
        params.seed_score_col = "P-value"
        params.batch_name = 'test'
        process.resourceLimits = [
                cpus:   2,
                memory: 8.GB
        ]
        process {
            withName: 'doNetColoc' {
                maxForks = 1
    }
}

    }
}